{
  "name": "modelshift",
  "version": "0.2.0",
  "description": "Offline conversion between mainstream 3D asset formats. CLI + static web UI, no server.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "modelshift": "./dist/cli/modelshift.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build:core": "tsup --config tsup.config.ts && npm run build:vendor",
    "build:cli": "tsup --config tsup.cli.config.ts && npm run build:vendor",
    "build:client": "vite build",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:source": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:source && npm run typecheck:test",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release:check": "npm run check && npm run build",
    "prepack": "npm run release:check",
    "make-fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jszip": "^3.10.1",
    "meshoptimizer": "^1.2.0",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.13",
    "watlas": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@gltf-transform/core": "^4.1.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
